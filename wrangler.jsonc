{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openclaw-medical-ai",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-04",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "openclaw-medical-ai"
		}
	],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"vars": {
		"AI_GATEWAY_ID": "default",
		"PUBMED_BASE_URL": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils"
	}
	// D1, KV, and Vectorize bindings will be added after resource creation:
	// npx wrangler d1 create openclaw-medical-db
	// npx wrangler kv namespace create SESSION_KV
	// Then update this file with the generated IDs.
}
